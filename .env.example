# ═══════════════════════════════════════════════════════════════
# Copy to .env.local — also set the same on Vercel (Production)
# ═══════════════════════════════════════════════════════════════

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Paddle
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENV=sandbox

# Subscriptions
NEXT_PUBLIC_PADDLE_PRICE_ID=
NEXT_PUBLIC_PADDLE_PRICE_ID_GROWTH=
NEXT_PUBLIC_PADDLE_PRICE_ID_PRO_VOICE=

# Minute packs (one-time)
NEXT_PUBLIC_PADDLE_PRICE_ID_PACK_50=
NEXT_PUBLIC_PADDLE_PRICE_ID_PACK_100=
NEXT_PUBLIC_PADDLE_PRICE_ID_PACK_300=
NEXT_PUBLIC_PADDLE_PRICE_ID_PACK_500=
NEXT_PUBLIC_PADDLE_PRICE_ID_PACK_1000=

# WhatsApp
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CRON_SECRET=change_me

# Admin = always Pro
NEXT_PUBLIC_ADMIN_EMAILS=you@gmail.com

# Vapi
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
