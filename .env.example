# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Paddle (one monthly price only)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_...
NEXT_PUBLIC_PADDLE_PRICE_ID=pri_...
NEXT_PUBLIC_PADDLE_ENV=sandbox
PADDLE_API_KEY=pdl_...
PADDLE_WEBHOOK_SECRET=pdl_ntfset_...
PADDLE_ENV=sandbox

# Meta WhatsApp
WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_VERIFY_TOKEN=any_secret_you_choose

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CRON_SECRET=long_random_string

# Your email = always Pro (no payment)
NEXT_PUBLIC_ADMIN_EMAILS=mmubashi75@gmail.com

# Vapi voice (optional but needed for /voice)
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
